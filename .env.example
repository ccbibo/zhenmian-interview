# 僅填在本機 .env；不要把金鑰貼到聊天、截圖或提交版本控制。
TAVUS_API_KEY=
TAVUS_PAL_ID=
TAVUS_FACE_ID=
# 可選：角色 lin/chen/hsu/chou → 授權 face_id 的 JSON 對應
TAVUS_FACE_MAP={}
PORT=4180
# 文字練習與有據回饋（DeepSeek 帳戶）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash

# 測試期間每場最多兩分鐘；正式開放前另行調整
TAVUS_MAX_CALL_SECONDS=120
